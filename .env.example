# ==============================================================================
# ClipForge AI - Environment Configuration Example
# ==============================================================================

# Backend Configuration
PROJECT_NAME="ClipForge AI"
API_V1_STR="/api"
SECRET_KEY="replace-with-a-random-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: SQLite for seamless local zero-config testing
DATABASE_URL="sqlite:///./clipforge.db"
# PostgreSQL production connection string:
# DATABASE_URL="postgresql://clipforge:clipforge_secure_password@localhost:5432/clipforge_db"

# AI Integration (OpenAI API for GPT-4o analysis and Whisper transcription)
# Leave empty to test with built-in development highlight and transcription engine
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
WHISPER_MODEL="whisper-1"

# YouTube Data API & Auto-Download (Local Dev)
YOUTUBE_API_KEY=""
ENABLE_YOUTUBE_DOWNLOAD=true
YOUTUBE_DOWNLOAD_MAX_RESOLUTION=1080

# Video Processing & Storage Limits
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR="data/uploads"
OUTPUT_DIR="data/outputs"

# Custom FFmpeg binary path (leave empty to auto-detect system or bundled imageio-ffmpeg)
FFMPEG_PATH=""

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
